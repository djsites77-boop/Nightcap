DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:4500/nightcap?schema=public"

BETTER_AUTH_SECRET="generate-with: openssl rand -hex 32"
# Default/fallback URL — keep as localhost; ngrok works alongside via NGROK_DOMAIN below
BETTER_AUTH_URL="http://localhost:3500"

ENCRYPTION_KEY="generate-with: openssl rand -hex 32"

HOSPITABLE_CLIENT_ID=""
HOSPITABLE_CLIENT_SECRET=""
GUESTY_CLIENT_ID=""
GUESTY_CLIENT_SECRET=""

DOCUMENT_STORAGE_DRIVER="local"
DOCUMENT_STORAGE_LOCAL_DIR="./.data/documents"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3500"

# Google OAuth (optional). Create credentials at https://console.cloud.google.com/
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="true"

# ngrok reserved domain — enables https://nightcap.ngrok.app alongside localhost (no .env swap)
NGROK_DOMAIN="nightcap.ngrok.app"
# Optional extra hosts (e.g. phone on LAN): BETTER_AUTH_ALLOWED_HOSTS="192.168.2.51:3500"

# Shared secret for the /api/cron/sync-calendars route (self-hosted cron / Vercel Cron).
CRON_SECRET="generate-with: openssl rand -hex 16"

# Optional: enables AI-assisted compliance-rule extraction in the admin panel (suggestion-only, always human-reviewed before saving).
ANTHROPIC_API_KEY=""
